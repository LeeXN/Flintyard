{
  "api_version": "flintyard/v1alpha1",
  "kind": "Environment",
  "name": "ci-lab",
  "architecture": "aarch64",
  "network": {
    "cidr": "auto",
    "nat": false,
    "dns": []
  },
  "nodes": [
    {
      "name": "node-1",
      "image": "images/ubuntu-aarch64.fyimg",
      "vcpu_count": 2,
      "memory_mib": 1024
    },
    {
      "name": "node-2",
      "image": "images/ubuntu-aarch64.fyimg",
      "vcpu_count": 2,
      "memory_mib": 1024
    },
    {
      "name": "node-3",
      "image": "images/ubuntu-aarch64.fyimg",
      "vcpu_count": 2,
      "memory_mib": 1024
    }
  ],
  "access": {
    "public_key": "keys/ci_ed25519.pub",
    "probe": {
      "type": "ssh_banner",
      "port": 22
    }
  },
  "port_forwards": []
}
