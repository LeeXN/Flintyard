{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flintyard:result-v1",
  "title": "Flintyard result-v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "flintyard/v1alpha1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^E_[A-Z_]+$"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "stage": {
              "type": "string",
              "minLength": 1
            },
            "node": {
              "type": [
                "string",
                "null"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "stage",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "api_version",
    "operation_id",
    "ok",
    "data",
    "error"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "ok": {
          "const": true
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^E_[A-Z_]+$"
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "stage": {
              "type": "string",
              "minLength": 1
            },
            "node": {
              "type": [
                "string",
                "null"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "stage",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
