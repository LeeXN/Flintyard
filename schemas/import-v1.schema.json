{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flintyard:import-v1",
  "title": "Flintyard import-v1",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "flintyard/v1alpha1"
    },
    "kind": {
      "const": "ImageImport"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "architecture": {
      "type": "string",
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "os": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "family",
        "release"
      ],
      "additionalProperties": false
    },
    "boot": {
      "type": "object",
      "properties": {
        "kernel_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "initrd_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rootfs_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "root_device": {
          "type": "string",
          "pattern": "^/dev/[A-Za-z0-9/_=-]+$"
        },
        "virtio_transport": {
          "type": "string",
          "enum": ["mmio", "pci"]
        },
        "kernel_args": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "kernel_path",
        "rootfs_path",
        "root_device",
        "kernel_args"
      ],
      "additionalProperties": false
    },
    "kernel": {
      "type": "object",
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "origin": {
          "type": "string",
          "enum": [
            "distribution-binary",
            "distribution-source",
            "upstream-source",
            "user-provided"
          ]
        },
        "modules": {
          "type": "string",
          "enum": [
            "embedded",
            "none"
          ]
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "release",
        "origin",
        "modules"
      ],
      "additionalProperties": false
    },
    "initialization": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "seed-v1"
            },
            "profile": {
              "type": "string",
              "enum": [
                "systemd-networkd",
                "networkmanager",
                "openrc-ifupdown"
              ]
            },
            "username": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
            },
            "probe": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "ssh_banner",
                    "tcp",
                    "none"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "type",
                "port"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mode",
            "profile",
            "username",
            "probe"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "external"
            },
            "username": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
            },
            "probe": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "ssh_banner",
                    "tcp",
                    "none"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "type",
                "port"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mode",
            "username",
            "probe"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "kernel",
              "rootfs",
              "initrd"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "required": [
    "api_version",
    "kind",
    "name",
    "version",
    "architecture",
    "os",
    "boot",
    "kernel",
    "initialization",
    "inputs"
  ],
  "additionalProperties": false
}
